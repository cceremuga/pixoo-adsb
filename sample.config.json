{
  "adsb": {
    "host": "192.168.1.100",
    "port": 8080,
    "path": "/data/aircraft.json",
    "poll_interval": 15,
    "receiver_lat": 0.0,
    "receiver_lon": 0.0
  },
  "pixoo": {
    "host": "192.168.1.200",
    "brightness": 100
  },
  "logos": {
    "cache_dir": "cache/logos",
    "fetch_timeout": 5
  },
  "flight_data": {
    "enabled": true,
    "cache_dir": "cache/routes",
    "cache_ttl_seconds": 10800,
    "sources": [
      {
        "type": "aeroapi",
        "enabled": false,
        "api_key": ""
      },
      {
        "type": "aerodatabox",
        "enabled": false,
        "api_key": ""
      },
      {
        "type": "hexdb",
        "enabled": true
      },
      {
        "type": "adsbdb",
        "enabled": true
      }
    ]
  },
  "display": {
    "color_background": "#112D4E",
    "color_separator": "#0C223B",
    "color_flight": "#F9F7F7",
    "color_route": "#DBE2EF",
    "color_data": "#DBE2EF",
    "fl_transition_ft": 18000,
    "distance_unit": "km"
  },
  "operating_hours": {
    "enabled": false,
    "start": "07:00",
    "end": "23:00"
  }
}
